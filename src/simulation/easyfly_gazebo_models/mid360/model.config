<?xml version="1.0"?>

<model>
  <name>mid360</name>
  <version>1.0</version>
  <sdf version="1.6">mid360.sdf</sdf>

  <author>
    <name>Francesco Vultaggio</name>
    <email>Francesco.Vultaggio@ait.ac.at</email>
  </author>

  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>

  <description>
    Livox MID-360 (水平安装) Gazebo 仿真模型。
    输出: /livox/lidar (livox_ros_driver2/CustomMsg) + /livox/imu (sensor_msgs/Imu)。
    基于 Livox-SDK/livox_laser_simulation 改造, 仿真插件为 easyfly 移植的
    liblivox_laser_simulation.so (ROS2)。
  </description>
</model>
