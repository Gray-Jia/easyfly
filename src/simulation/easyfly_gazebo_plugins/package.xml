<?xml version="1.0"?>
<package format="3">
  <name>easyfly_gazebo_plugins</name>
  <version>0.1.0</version>
  <description>Gazebo sensor plugins for EasyFly (Livox/RealSense/Velodyne emulation)</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>gazebo_dev</depend>
  <depend>livox_ros_driver2</depend>
  <depend>rosidl_cmake</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
