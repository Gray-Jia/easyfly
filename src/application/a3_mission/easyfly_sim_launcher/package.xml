<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easyfly_sim_launcher</name>
  <version>0.1.0</version>
  <description>A3: One-click full simulation launcher for EasyFly</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>easyfly_px4_sitl</exec_depend>
  <exec_depend>easyfly_mavlink_bridge</exec_depend>
  <exec_depend>easyfly_params</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
