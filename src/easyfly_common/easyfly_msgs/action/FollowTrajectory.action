# 轨迹跟随 (M4.3): 把 EGO-Planner /position_cmd 流转发为 UAVCommand TRAJECTORY
# 进入条件: 仅 HOVER (与既有单动作槽互斥); 需已 arm + OFFBOARD
float64 target_x            # 轨迹终点 x [m]，固定 odom/ENU（到达判定用）
float64 target_y
float64 target_z
float64 acceptance_radius   # 到达判定半径 [m], 0=默认 0.8
float64 timeout             # 安全超时 [s], 0=默认 120
---
# 结果
bool success
string message              # arrived / stream_lost / takeover / timeout / canceled
---
# 反馈
float64 distance_remaining  # 到终点距离 [m]
bool   stream_active        # /position_cmd 是否在流 (0.5s 内收到新指令)
