<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easyfly_flight_control</name>
  <version>0.1.0</version>
  <description>E3: Flight controller — Takeoff / Land / GoToWaypoint action servers with PID</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>easyfly_msgs</depend>

  <exec_depend>easyfly_mavlink_bridge</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
