<!-- Explicit same-host D5 simulation transport. Never a global DDS override. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>d5_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>d5_shm</transport_id>
      <type>SHM</type>
      <maxMessageSize>4194304</maxMessageSize>
      <segment_size>67108864</segment_size>
      <port_queue_capacity>512</port_queue_capacity>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="d5_simulation" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>d5_udp</transport_id>
        <transport_id>d5_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
