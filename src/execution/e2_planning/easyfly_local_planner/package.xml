<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easyfly_local_planner</name>
  <version>0.1.0</version>
  <description>E2: EGO-Planner 适配/编排 (M4.3) — launch 接线第三方 EGO 到 easyfly 数据链</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ego_planner</exec_depend>
  <exec_depend>traj_utils</exec_depend>
  <exec_depend>quadrotor_msgs</exec_depend>
  <exec_depend>easyfly_pointcloud_filter</exec_depend>
  <exec_depend>easyfly_coord_transform</exec_depend>
  <exec_depend>easyfly_flight_control</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
